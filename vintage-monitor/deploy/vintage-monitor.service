[Unit]
Description=Vintage Monitor (eBay deal alerts to Discord)
Documentation=file:///opt/vintage-monitor/vintage-monitor/README.md
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=vmonitor
Group=vmonitor
WorkingDirectory=/opt/vintage-monitor/vintage-monitor
ExecStart=/usr/bin/python3 -m vintage_monitor run --config /opt/vintage-monitor/vintage-monitor/config.toml --env /etc/vintage-monitor/.env --db /var/lib/vintage-monitor/monitor.db
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Restart=always
RestartSec=30

# Creates /var/lib/vintage-monitor owned by the service user.
StateDirectory=vintage-monitor
StateDirectoryMode=0750

# Hardening: the monitor only needs to read its code and secrets, write its
# database, and make outgoing HTTPS connections.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
