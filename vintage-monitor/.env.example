# Vintage Monitor secrets.
#
# On the server this file lives at /etc/vintage-monitor/.env
# NEVER commit the real file to GitHub and never paste it into a chat.
# Replace each PASTE_... value; no quotes or spaces needed.

# eBay developer site -> Application Keys -> Production keyset
EBAY_CLIENT_ID=PASTE_YOUR_PRODUCTION_APP_ID
EBAY_CLIENT_SECRET=PASTE_YOUR_PRODUCTION_CERT_ID

# Discord -> #deals -> Edit Channel -> Integrations -> Webhooks -> Copy Webhook URL
DISCORD_WEBHOOK_URL=PASTE_YOUR_DISCORD_WEBHOOK_URL
